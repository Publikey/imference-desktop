{
  "version": 1,
  "tools": [
    {
      "id": "convert",
      "version": "1.0.0",
      "name": "Convert / compress",
      "description": "Convert to PNG, JPEG or WebP and set the compression quality.",
      "category": "image",
      "mcp_name": "convert",
      "inputs": {
        "image": {
          "type": "image",
          "required": true,
          "description": "Source image",
          "max_megapixels": 40,
          "max_mb": 30
        }
      },
      "params": {
        "format": {
          "type": "enum",
          "default": "webp",
          "values": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "quality": {
          "type": "int",
          "default": 85,
          "description": "JPEG/WebP quality.",
          "min": 1,
          "max": 100
        },
        "lossless": {
          "type": "bool",
          "default": false,
          "description": "WebP lossless."
        },
        "max_kb": {
          "type": "int",
          "description": "Lower the quality until the file fits (JPEG/WebP).",
          "min": 10,
          "max": 50000
        },
        "background": {
          "type": "string",
          "default": "#ffffff",
          "description": "Fill for transparent pixels when the format has no alpha (JPEG).",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "outputs": {
        "image": {
          "type": "image"
        }
      },
      "runtimes": {
        "local": [
          "cpu",
          "cuda",
          "mps",
          "rocm",
          "directml"
        ],
        "cloud_queue": "tools-cpu",
        "slow_on_cpu": false,
        "min_vram_gb": 0.0,
        "min_ram_gb": 0.0,
        "needs_engine": false
      },
      "cost": {
        "credits": 1.0
      },
      "license": {
        "spdx": "n/a",
        "source": "Pillow (HPND)",
        "verified": true
      },
      "available": true,
      "weights_mb": 0,
      "cloud_available": true
    },
    {
      "id": "crop",
      "version": "1.0.0",
      "name": "Crop",
