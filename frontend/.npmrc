# `wails3 dev` runs `npm install` on every build, so npm's output is part of the
# dev loop. Pin it to warnings here: a machine-level `loglevel=verbose` in
# ~/.npmrc otherwise buries the actual build output under ~40 lines of reify
# chatter each time. Project config wins over user config; drop this file to
# fall back to whatever the machine is set to.
loglevel=warn
